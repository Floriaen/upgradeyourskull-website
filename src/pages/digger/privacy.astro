---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
---

<BaseLayout title="Privacy Policy — DIGGER" description="Privacy policy for DIGGER by Upgrade Your Skull">
  <Header />

  <main class="max-w-6xl mx-auto px-4 py-12">
    <article class="max-w-3xl">
      <SectionHeading title="Privacy Policy — DIGGER" />
      <p class="text-sm mb-10" style="color:var(--color-text-muted)">Last updated: May 14, 2026</p>

      <section class="mb-10">
        <h3 class="text-xl font-bold mb-3 text-[var(--color-text-primary)]">1. Who we are</h3>
        <p class="leading-relaxed">
          DIGGER is developed and published by Upgrade Your Skull. For any privacy-related questions, contact us at:
          <a href="mailto:privacy@upgradeyourskull.com" class="underline">privacy@upgradeyourskull.com</a>
        </p>
      </section>

      <section class="mb-10">
        <h3 class="text-xl font-bold mb-3 text-[var(--color-text-primary)]">2. What data we collect</h3>
        <p class="leading-relaxed mb-3">
          DIGGER does not collect any personal information. We do not ask for your name, email address, location, or any data that could identify you.
        </p>
        <p class="leading-relaxed">
          We collect anonymous usage statistics — such as gameplay events, session duration, and feature interactions — for the sole purpose of understanding how the game is used and improving it. This data cannot be linked back to any individual.
        </p>
      </section>

      <section class="mb-10">
        <h3 class="text-xl font-bold mb-3 text-[var(--color-text-primary)]">3. Analytics</h3>
        <p class="leading-relaxed">
          We use PostHog to collect anonymous analytics. PostHog processes aggregated, non-personal event data. No personally identifiable information is transmitted. You can review PostHog's own privacy practices at
          <a href="https://posthog.com/privacy" class="underline" target="_blank" rel="noopener noreferrer">posthog.com/privacy</a>.
        </p>
      </section>

      <section class="mb-10">
        <h3 class="text-xl font-bold mb-3 text-[var(--color-text-primary)]">4. Data sharing</h3>
        <p class="leading-relaxed">
          We do not sell, trade, or share your data with third parties, except for PostHog as described above, which acts solely as a data processor on behalf of Upgrade Your Skull.
        </p>
      </section>

      <section class="mb-10">
        <h3 class="text-xl font-bold mb-3 text-[var(--color-text-primary)]">5. Children</h3>
        <p class="leading-relaxed">
          DIGGER does not knowingly collect any data from children under 13.
        </p>
      </section>

      <section class="mb-10">
        <h3 class="text-xl font-bold mb-3 text-[var(--color-text-primary)]">6. Changes to this policy</h3>
        <p class="leading-relaxed">
          We may update this policy occasionally. The &ldquo;Last updated&rdquo; date at the top of this page reflects the most recent revision. Continued use of the game after changes constitutes acceptance of the updated policy.
        </p>
      </section>

      <section class="mb-10">
        <h3 class="text-xl font-bold mb-3 text-[var(--color-text-primary)]">7. Contact</h3>
        <p class="leading-relaxed">
          <a href="mailto:privacy@upgradeyourskull.com" class="underline">privacy@upgradeyourskull.com</a>
        </p>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>
