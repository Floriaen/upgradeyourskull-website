---
const devLinks = [
  { href: '/brokenheart', label: '2012 #js1k entry - Find the color of Love' },
  { href: 'https://js1k.com/2013-spring/demo/1379', label: '2013 #js1k entry - Sunflower' },
  { href: '/pixelbutton', label: 'PixelButton' },
  { href: '/xcode4', label: 'Xcode 4 portage of the TextMate Theme by Zachary Johnson' },
  { href: '/wait', label: 'Wait...' },
];
---

<ul class="flex flex-col gap-2 list-none m-0 p-0">
  {devLinks.map(link => (
    <li>
      <a href={link.href} target="_blank" rel="noreferrer"
        class="text-sm hover:underline" style="color:var(--color-accent)">
        {link.label}
      </a>
    </li>
  ))}
</ul>
