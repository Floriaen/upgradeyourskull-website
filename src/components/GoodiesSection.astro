---
const goodiesLinks = [
  { href: '/weareanonymous', label: 'We are Anonymous' },
  { href: '/chagevara', label: 'Chagevara' },
];
---

<ul class="flex flex-col gap-2 list-none m-0 p-0">
  {goodiesLinks.map(link => (
    <li>
      <a href={link.href} target="_blank" rel="noreferrer"
        class="text-sm hover:underline" style="color:var(--color-accent)">
        {link.label}
      </a>
    </li>
  ))}
</ul>
