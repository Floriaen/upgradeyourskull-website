---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  url: string;
}
const { name, url } = Astro.props;

const iconImports = import.meta.glob<{ default: ImageMetadata }>(
  '../images/platform/*',
  { eager: true }
);

const icons: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(iconImports)) {
  const filename = path.split('/').pop()!.replace(/\.[^.]+$/, '');
  icons[filename] = mod.default;
}

const img = icons[name];
---

{img && (
  <a href={url} target="_blank" rel="noreferrer" title={name}
    class="block opacity-70 hover:opacity-100 transition-opacity">
    <Image src={img} alt={name} width={24} height={24}
      class="block" style="width:24px;height:24px;object-fit:contain" />
  </a>
)}
